<?xml version="1.0" encoding="utf-8"?>
<!-- Settings gear (toolbar action): gold ring on D-pad focus, normal borderless ripple on touch. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/tv_focus_fill" />
            <stroke android:width="1.5dp" android:color="@color/tv_focus_border" />
        </shape>
    </item>
    <item android:drawable="?attr/selectableItemBackgroundBorderless" />
</selector>
