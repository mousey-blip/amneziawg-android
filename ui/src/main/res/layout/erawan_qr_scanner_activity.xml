<?xml version="1.0" encoding="utf-8"?>
<!-- Same DecoratedBarcodeView setup as zxing's default zxing_capture.xml, with a gallery
     shortcut overlaid in the bottom-end corner so the camera scanner and gallery-image
     import live on one screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false" />

    <ImageButton
        android:id="@+id/qr_gallery_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:background="@drawable/bg_qr_scanner_gallery_button"
        android:contentDescription="@string/qr_scanner_gallery_button_description"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_action_scan_qr_gallery" />

</FrameLayout>
